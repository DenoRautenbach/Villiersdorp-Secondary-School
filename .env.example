# Copy to .env.local for local development. Set the same values in Vercel → Settings → Environment Variables.

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://your-domain.co.za
# Optional: Google Search Console verification code
GOOGLE_SITE_VERIFICATION=

# ── Sanity ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# ── Facebook → news sync (optional; the sync is off until all of these are set) ──
# See docs/facebook-sync.md
SANITY_API_WRITE_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Random string; Vercel sends it to the cron job automatically
CRON_SECRET=
# Optional: only import posts containing this hashtag, e.g. #nuus (removed from the imported text)
FACEBOOK_SYNC_HASHTAG=
# Optional: how many recent posts to check per run (default 10, max 50)
FACEBOOK_SYNC_LIMIT=10
# Optional: Graph API version (default v23.0)
FACEBOOK_GRAPH_VERSION=
